<Window x:Class="Shell.ImportReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="620" Width="980" MinHeight="420" MinWidth="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Language="ru-RU">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="MinRowHeight" Value="30" />
        </Style>
        <Style x:Key="ReportCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="6,5" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Отчёт импорта папки" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock Text="{Binding FolderPath}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="Предупреждения не отменяют принятие файла." TextWrapping="Wrap" Foreground="#666666" />
            <TextBlock Text="{Binding Notification}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Notification}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="Принятые файлы">
                <DataGrid ItemsSource="{Binding Report.Accepted}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Файл" Width="240" Binding="{Binding FileName}" ElementStyle="{StaticResource ReportCell}" />
                        <DataGridTextColumn Header="Результат" Width="*" Binding="{Binding Action}" ElementStyle="{StaticResource ReportCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Отклонённые файлы">
                <DataGrid ItemsSource="{Binding Report.Rejected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Файл" Width="240" Binding="{Binding FileName}" ElementStyle="{StaticResource ReportCell}" />
                        <DataGridTextColumn Header="Причина" Width="*" Binding="{Binding Reason}" ElementStyle="{StaticResource ReportCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Предупреждения">
                <DataGrid ItemsSource="{Binding Report.Warnings}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Файл" Width="240" Binding="{Binding FileName}" ElementStyle="{StaticResource ReportCell}" />
                        <DataGridTextColumn Header="Предупреждение" Width="*" Binding="{Binding Message}" ElementStyle="{StaticResource ReportCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
